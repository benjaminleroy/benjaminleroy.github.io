<div id="mySidenav" class="sidenav">
  <a href="javascript:void(0)" class="closebtn" onclick="closeNav()">&times;</a>
  <a href="../index.html">Stat 315 Home</a>
  <div class = "dropdown">
            <div onclick ="mydropdownFunction()" class = "dropbtn">
              Lectures
            </div>
            <div id = "myDropdown" class = "dropdown-content">
            <a href = "#"> Lecture 1 </a>
            <a href = "#"> Lecture 2 </a>

            </div>
          </div>

</div>

<div class = ""
<div class = "col-sm-4 left" style="font-size:20px;cursor:pointer" onclick="openNav()">&#9776; Statistics 36-315
</div> 


<script>
function openNav() {
    document.getElementById("mySidenav").style.width = "180px";
}

function closeNav() {
    document.getElementById("mySidenav").style.width = "0";
}
</script>

